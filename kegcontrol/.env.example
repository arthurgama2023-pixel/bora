# KegControl — variáveis de ambiente (copie para .env e preencha)

# Banco: Postgres do Supabase (pooler + schema dedicado kegcontrol)
DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-1-us-east-2.pooler.supabase.com:5432/postgres?schema=kegcontrol"

# Segredo de sessão + chave de criptografia (AES-GCM) das credenciais do WhatsApp.
# Use o MESMO valor em todos os ambientes que compartilham o banco.
AUTH_SECRET="troque-por-um-segredo-forte-e-unico"

# IA do agente (Gemini). Sem ela, o agente roda em modo simulado.
GEMINI_API_KEY=""

# URL pública do app — necessária para o WhatsApp RECEBER mensagens (webhook).
APP_URL="http://localhost:3020"

# WhatsApp via Evolution API (self-hosted, WhatsApp Web). A instância é criada
# por empresa automaticamente (kegcontrol-<companyId>).
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# Números (separados por vírgula) que o agente atende. Vazio = atende todos.
WHATSAPP_ALLOWED_NUMBERS=""

# Observabilidade (Sentry) — captura erro em produção e vira Issue no GitHub.
# NÃO é segredo sensível (roda até no navegador do usuário), mas fica em env
# var pra poder trocar de projeto Sentry sem mexer em código.
NEXT_PUBLIC_SENTRY_DSN=""

# Opcional: só necessário se quiser enviar source maps no build (stack trace
# legível no painel do Sentry em vez de código minificado). Gerar em
# sentry.io → Settings → Auth Tokens. Sem ele, o build funciona normal.
SENTRY_AUTH_TOKEN=""

# Vigia — avisa no Telegram quando o agente cai/desconecta ou aparece bug novo.
# Mesmo bot usado pelo workflow .github/workflows/kegcontrol-vigia.yml (lá são
# GitHub Actions secrets; aqui são env vars do APP — precisam ser cadastradas
# nos dois lugares, são cofres diferentes).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Token compartilhado que valida a chamada do Sentry em /api/webhooks/sentry
# (alerta instantâneo de bug novo, sem esperar o ciclo do vigia). Opcional —
# sem ele, a rota aceita qualquer chamada (como o KEEPALIVE_TOKEN). Gere um
# valor aleatório e cadastre o MESMO no campo da URL do webhook, no Sentry.
SENTRY_WEBHOOK_TOKEN=""

# Token PESSOAL do Sentry (prefixo sntryu_, escopos project:read + event:read
# + org:read) — o webhook usa pra ir buscar o relatório DE VERDADE (onde no
# código, quantos usuários afetados, desde quando) em vez de só repassar
# título+link. Sem ele, o alerta ainda funciona, só sem o enriquecimento.
# Gerar em sentry.io → conta → Auth Tokens.
SENTRY_API_TOKEN=""

# Protege /api/health/price-check (canário de preço, cron externo a cada 4h em
# .github/workflows/kegcontrol-price-check.yml). Opcional como os outros, MAS
# esta rota dispara uma chamada REAL ao Gemini (custo) — recomendado sempre
# definir em produção, pra ninguém rodar o teste à vontade só sabendo a URL.
PRICE_CHECK_TOKEN=""
