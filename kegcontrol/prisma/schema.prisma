// KegControl — modelo de dados
// Dev: SQLite · Produção: PostgreSQL (trocar provider + DATABASE_URL)
// SQLite não suporta enums nativos: campos de enum são String validados por Zod
// (src/lib/enums.ts). Na migração para PostgreSQL podem virar enums nativos.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── SaaS: toda entidade pertence a uma empresa ────────────────────────────
model Company {
  id        String   @id @default(cuid())
  name      String
  document  String? // CNPJ
  createdAt DateTime @default(now())

  users         User[]
  customers     Customer[]
  kegTypes      KegType[]
  stockBalances StockBalance[]
  movements     Movement[]
  auditLogs     AuditLog[]
  agentConfig   AgentConfig?
  agentMessages AgentMessage[]
  campaignRules CampaignRule[]
  dispatches    Dispatch[]
  settings      Setting[]
  siteOrders    SiteOrder[]
  paymentProofs PaymentProof[]
  siteVisits    SiteVisit[]
}

// Configurações chave/valor por empresa (ex.: credenciais do WhatsApp/Evolution).
// Valores sensíveis (apiKey) são guardados criptografados (AES-256-GCM).
model Setting {
  id        String   @id @default(cuid())
  companyId String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  email        String   @unique
  passwordHash String
  role         String // ADMIN | MANAGER | STOCKIST
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  movements Movement[]
  auditLogs AuditLog[]
}

model Customer {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  // Nome de exibição do WhatsApp (pushName). NÃO é o nome do cadastro — serve só
  // pra saudar e pro dono reconhecer o contato em "Não registrados". O nome real
  // vem quando o AGENTE PERGUNTA e o cliente responde (aí grava em `name`).
  pushName    String?
  companyName String?
  type        String   @default("COMERCIO") // COMERCIO | DELIVERY | EVENTOS
  document    String? // CPF/CNPJ
  phone       String?
  whatsapp    String?
  email       String?
  address      String?
  neighborhood String? // bairro
  city         String?
  state        String?
  contactName  String? // responsável
  notes        String?
  openBalance  Float    @default(0) // valor em aberto (dívida) — referência manual
  status       String   @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED
  agentEnabled Boolean  @default(false) // agente IA só atende quem o dono liberar (trancado por padrão)
  source       String   @default("MANUAL") // MANUAL (cadastrado no painel) | AGENTE (auto-criado pelo WhatsApp)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id])
  stockBalances StockBalance[]
  movements     Movement[]
  prices        CustomerPrice[]

  @@index([companyId, name])
  @@index([companyId, status])
}

// Preço negociado por cliente e tipo de barril (cada cliente paga um valor
// diferente pelo mesmo tipo — ex.: atacado x varejo, contrato antigo, etc.).
model CustomerPrice {
  id         String   @id @default(cuid())
  companyId  String
  customerId String
  kegTypeId  String
  price      Float
  quantity   Int      @default(0) // quantidade acordada/de referência deste tipo
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  kegType  KegType  @relation(fields: [kegTypeId], references: [id])

  @@unique([customerId, kegTypeId])
  @@index([companyId])
}

model KegType {
  id             String   @id @default(cuid())
  companyId      String
  name           String // ex.: Barril 50L
  capacityLiters Int
  code           String // ex.: BRL-50
  category       String   @default("BARRIL") // BARRIL | CHOPEIRA
  assetValue     Float    @default(0) // valor patrimonial unitário
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company       Company         @relation(fields: [companyId], references: [id])
  stockBalances StockBalance[]
  movementItems MovementItem[]
  customerPrices CustomerPrice[]

  @@unique([companyId, code])
}

// Saldo por "bucket": (tipo, local, condição, status) → quantidade.
// customerId null = depósito da distribuidora.
model StockBalance {
  id         String  @id @default(cuid())
  companyId  String
  kegTypeId  String
  customerId String?
  condition  String // FULL | EMPTY
  status     String // AVAILABLE | RESERVED | MAINTENANCE | LOST | WITH_CUSTOMER
  quantity   Int     @default(0)

  company  Company   @relation(fields: [companyId], references: [id])
  kegType  KegType   @relation(fields: [kegTypeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@unique([companyId, kegTypeId, customerId, condition, status])
  @@index([companyId, customerId])
}

// Movimentação: cabeçalho imutável (sem update/delete; correção = novo movimento
// ADJUSTMENT com correctsId apontando para o original).
model Movement {
  id          String   @id @default(cuid())
  companyId   String
  number      Int // sequencial por empresa (MOV-000123)
  type        String // DELIVERY | PICKUP | SWAP | PURCHASE | SALE | ADJUSTMENT | LOSS | MAINTENANCE
  occurredAt  DateTime @default(now())
  customerId  String?
  userId      String
  origin      String?
  destination String?
  notes       String?
  correctsId  String?
  createdAt   DateTime @default(now())

  company    Company        @relation(fields: [companyId], references: [id])
  customer   Customer?      @relation(fields: [customerId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  corrects   Movement?      @relation("Correction", fields: [correctsId], references: [id])
  correctedBy Movement[]    @relation("Correction")
  items      MovementItem[]

  @@unique([companyId, number])
  @@index([companyId, occurredAt])
  @@index([companyId, customerId])
}

// Item: partida dobrada — move quantity do bucket origem para o destino.
// EXTERNAL não é bucket (compra cria patrimônio, venda remove).
model MovementItem {
  id           String @id @default(cuid())
  movementId   String
  kegTypeId    String
  quantity     Int
  condition    String // condição na ORIGEM: FULL | EMPTY
  toCondition  String? // condição no DESTINO quando muda (envase, retorno vazio); null = igual à origem
  fromLocation String // WAREHOUSE | CUSTOMER | MAINTENANCE | LOST | EXTERNAL
  toLocation   String // WAREHOUSE | CUSTOMER | MAINTENANCE | LOST | EXTERNAL
  fromStatus   String? // status do bucket de origem (ex.: AVAILABLE, RESERVED)
  toStatus     String? // status do bucket de destino

  movement Movement @relation(fields: [movementId], references: [id])
  kegType  KegType  @relation(fields: [kegTypeId], references: [id])

  @@index([movementId])
}

// Pedido feito pelo SITE (ss-chopp) — capturado quando o cliente finaliza.
// NÃO é movimentação de estoque: entra como PENDING e a SS-Chopp confirma no
// painel (aí sim vira Movement, manualmente). É a ponte entre o site estático
// e o controle interno, sem deixar um endpoint público mexer no patrimônio.
model SiteOrder {
  id             String   @id @default(cuid())
  companyId      String
  customerName   String
  phone          String
  email          String?
  document       String? // CPF/CNPJ
  deliveryMethod String // entrega | retirada
  neighborhood   String?
  city           String?
  street         String?
  number         String?
  complement     String?
  hasStairs      String? // sim | nao
  venueType      String? // casa | salao
  eventDate      String? // data do evento (texto vindo do site)
  eventTime      String?
  chopeiraType   String? // eletrica | gelo
  items          String // JSON: [{ id, name, quantity, unitPrice }]
  total          Float
  status         String   @default("PENDING") // PENDING (encaminhado ao WhatsApp) | SCHEDULED (entrega agendada) | CONFIRMED (legado = agendada) | CANCELLED
  origin         String   @default("SITE") // SITE (formulário do site) | AGENTE (fechado pelo agente IA no WhatsApp)
  notes          String?
  scheduledAt    DateTime? // quando virou "entrega agendada" — linha do tempo do pedido
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, status])
  @@index([companyId, phone])
}

// Visita/funil do checkout do SITE (ss-chopp). Cada visitante que chega no
// carrinho é UMA linha (chave: sessionId do navegador dele) que progride de
// estágio conforme preenche — sem esperar finalizar. É isso que dá visão de
// quem PAROU no meio (INICIOU), quem PREENCHEU mas não mandou (PREENCHENDO) e
// quem clicou finalizar no WhatsApp (FINALIZOU). Guarda só o que o cliente já
// tinha digitado (nome/telefone/bairro/itens/total) pra a SS-Chopp poder ligar.
model SiteVisit {
  id             String   @id @default(cuid())
  companyId      String
  sessionId      String // id do navegador do visitante (localStorage)
  stage          String   @default("INICIOU") // INICIOU | PREENCHENDO | FINALIZOU
  // Classificação do lead pelo dono na aba "Não finalizou": OPEN (não
  // finalizou) | DISPATCHED (recuperação disparada) | DISCARDED (descartado —
  // some da aba). O disparo real (dispatchedAt) também vale como DISPATCHED.
  status         String   @default("OPEN")
  customerName   String?
  phone          String?
  neighborhood   String?
  city           String?
  deliveryMethod String?
  itemsCount     Int      @default(0)
  total          Float    @default(0)
  // Snapshot JSON do que o cliente já tinha preenchido no formulário (endereço,
  // data/horário do evento, chopeira, itens, CPF, e-mail) — pra o card mostrar
  // "de acordo com o que foi preenchido", no mesmo formato do pedido finalizado.
  details        String?
  // Quando o agente foi DISPARADO pra esse lead (recuperação de carrinho). Nulo
  // = ainda não disparado; preenchido = card mostra "Disparado".
  dispatchedAt   DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, sessionId])
  @@index([companyId, stage])
}

// Comprovante de pagamento (foto) recebido no WhatsApp — o agente NÃO tenta
// ler/validar o comprovante, só guarda pra revisão humana na aba Verificação.
// Nenhuma imagem passa pelo Gemini nem vira dado de conversa.
model PaymentProof {
  id        String   @id @default(cuid())
  companyId String
  phone     String // quem mandou, no WhatsApp
  pushName  String? // nome de exibição do WhatsApp, se veio no webhook
  mimetype  String // image/jpeg, image/png, etc.
  imageData Bytes // a imagem em si — MVP: direto no banco, sem storage externo
  caption   String? // legenda que o cliente escreveu junto com a foto
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
}

// ─── Central IA: agente, CRM e disparos (módulo à parte, aditivo) ──────────

// Configuração do Agente IA — personalidade editável (system prompt).
model AgentConfig {
  id          String   @id @default(cuid())
  companyId   String   @unique
  name        String   @default("Bora") // nome do agente no atendimento
  personality String // system prompt editável na UI
  greeting    String? // primeira mensagem sugerida
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])
}

// Histórico de conversas de treino do agente (e futuramente do WhatsApp).
model AgentMessage {
  id         String   @id @default(cuid())
  companyId  String
  sessionId  String // agrupa uma conversa
  role       String // user | assistant
  content    String
  customerId String? // cliente em contexto, se identificado
  channel    String   @default("PLAYGROUND") // PLAYGROUND | WHATSAPP (futuro)
  createdAt  DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, sessionId])
}

// Regras de disparo automático (CRM): quem recebe, quando e qual mensagem.
model CampaignRule {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  trigger       String // INACTIVE_CUSTOMER | KEGS_HELD | REACTIVATION
  thresholdDays Int      @default(30)
  template      String // mensagem com variáveis {cliente} {dias} {barris}
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company    Company    @relation(fields: [companyId], references: [id])
  dispatches Dispatch[]
}

// Disparos gerados pelas regras. No MVP são SIMULATED (fila de treino);
// quando o WhatsApp for conectado, passam a PENDING → SENT.
model Dispatch {
  id         String   @id @default(cuid())
  companyId  String
  ruleId     String?
  customerId String
  channel    String   @default("WHATSAPP")
  message    String
  status     String   @default("SIMULATED") // SIMULATED | PENDING | SENT | FAILED
  createdAt  DateTime @default(now())

  company Company       @relation(fields: [companyId], references: [id])
  rule    CampaignRule? @relation(fields: [ruleId], references: [id])

  @@index([companyId, createdAt])
}

// Auditoria append-only: toda mutação registra quem/quando/o quê.
model AuditLog {
  id        String   @id @default(cuid())
  companyId String
  userId    String?
  action    String // CREATE | UPDATE | LOGIN | MOVEMENT | ...
  entity    String // Customer | KegType | User | Movement | ...
  entityId  String?
  changes   String? // JSON diff {campo: {de, para}}
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
}
